      "parameters": {
        "jsCode": "const pagosRows = $('Get row(s) - Pagos Programados')\n  .all()\n  .map(item => item.json)\n  .filter(row => row.pago_id);\n\nconst operacionesRows = $('Get row(s) - Operaciones')\n  .all()\n  .map(item => item.json)\n  .filter(row => row.operacion_id);\n\nconst clientesRows = $('Get row(s) - Clientes')\n  .all()\n  .map(item => item.json)\n  .filter(row => row.cliente_id);\n\nfunction toNumber(value) {\n  const clean = String(value || '')\n    .replace(/Bs\\.?/gi, '')\n    .replace(/\\s/g, '')\n    .replace(/,/g, '');\n\n  const num = Number(clean);\n  return Number.isFinite(num) ? num : 0;\n}\n\nfunction isOverdue(row) {\n  if (!row.fecha_programada) return false;\n  if (row.estado_pago === 'Pagado') return false;\n  if (toNumber(row.saldo_pago) <= 0) return false;\n\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n\n  const dueDate = new Date(`${row.fecha_programada}T00:00:00`);\n  return dueDate < today;\n}\n\nconst pagos = pagosRows.map((pago) => {\n  const operacion = operacionesRows.find(\n    (item) => String(item.operacion_id || '') === String(pago.operacion_id || '')\n  );\n\n  const cliente = clientesRows.find(\n    (item) => String(item.cliente_id || '') === String(pago.cliente_id || '')\n  );\n\n  let estadoPago = pago.estado_pago || 'Pendiente';\n\n  if (estadoPago !== 'Pagado' && isOverdue(pago)) {\n    estadoPago = 'Vencido';\n  }\n\n  return {\n    pago_id: pago.pago_id || '',\n    operacion_id: pago.operacion_id || '',\n    cliente_id: pago.cliente_id || '',\n    cliente_nombre: cliente?.razon_social || pago.cliente_id || '',\n    descripcion_operacion: operacion?.descripcion_operacion || '',\n    numero_pago: toNumber(pago.numero_pago),\n    concepto_pago: pago.concepto_pago || '',\n    porcentaje_programado: toNumber(pago.porcentaje_programado),\n    monto_programado: toNumber(pago.monto_programado),\n    fecha_programada: pago.fecha_programada || '',\n    estado_pago: estadoPago,\n    monto_pagado_acumulado: toNumber(pago.monto_pagado_acumulado),\n    saldo_pago: toNumber(pago.saldo_pago),\n    fecha_ultimo_pago: pago.fecha_ultimo_pago || '',\n    modalidad_pago: pago.modalidad_pago || '',\n    observaciones: pago.observaciones || '',\n    created_by: pago.created_by || '',\n    created_by_name: pago.created_by_name || '',\n    created_at: pago.created_at || '',\n    updated_by: pago.updated_by || '',\n    updated_by_name: pago.updated_by_name || '',\n    updated_at: pago.updated_at || '',\n  };\n});\n\nconst actor = $('Code - Normalize Action').first().json.actor || {};\nconst role = String(actor.role || '').trim();\nconst actorEmail = String(actor.email || '').trim().toLowerCase();\nconst actorName = String(actor.name || '').trim().toLowerCase();\n\nconst opOwner = {};\nfor (const op of operacionesRows) {\n  const id = String(op.operacion_id || '').trim();\n  if (id) opOwner[id] = op;\n}\n\nlet visibles = pagos;\nif (role !== 'admin') {\n  visibles = pagos.filter(function (p) {\n    const op = opOwner[String(p.operacion_id || '').trim()];\n    if (!op) return false;\n    const cb = String(op.created_by || '').trim().toLowerCase();\n    if (cb) return cb === actorEmail;\n    return String(op.responsable || '').trim().toLowerCase() === actorName;\n  });\n}\n\nreturn [\n  {\n    json: {\n      ok: true,\n      message: 'Pagos obtenidos correctamente.',\n      pagos: visibles,\n    },\n  },\n];"
