    {
      "parameters": {
        "jsCode": "const payload = $('Code - Normalize Action').first().json;\n\nconst operacion = payload.operacion || {};\nconst pagosInput = payload.pagos_programados || [];\nconst seguimientoInicial = payload.seguimiento_inicial || {};\n\nconst operacionesRows = $('Get row(s) - Operaciones Create')\n  .all()\n  .map(item => item.json)\n  .filter(row => row.operacion_id);\n\nconst pagosRows = $('Get row(s) - Pagos Create')\n  .all()\n  .map(item => item.json)\n  .filter(row => row.pago_id);\n\nconst seguimientoRows = $('Get row(s) - Seguimiento Create')\n  .all()\n  .map(item => item.json)\n  .filter(row => row.seguimiento_id);\n\nfunction nextId(rows, field, prefix) {\n  let max = 0;\n\n  for (const row of rows) {\n    const value = String(row[field] || '');\n    const match = value.match(new RegExp(`${prefix}-(\\\\d+)`));\n\n    if (match) {\n      const number = parseInt(match[1], 10);\n      if (number > max) max = number;\n    }\n  }\n\n  return `${prefix}-${String(max + 1).padStart(4, '0')}`;\n}\n\nfunction toNumber(value) {\n  const num = Number(value || 0);\n  return Number.isFinite(num) ? num : 0;\n}\n\nif (!operacion.cliente_id) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'Debe seleccionar un cliente.',\n      },\n    },\n  ];\n}\n\nif (!String(operacion.descripcion_operacion || '').trim()) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'La descripción de la operación es obligatoria.',\n      },\n    },\n  ];\n}\n\nif (!pagosInput.length) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'Debe existir al menos un pago programado.',\n      },\n    },\n  ];\n}\n\nconst montoTotal = toNumber(operacion.monto_total_comprometido);\n\nconst totalPorcentaje = pagosInput.reduce(\n  (sum, pago) => sum + toNumber(pago.porcentaje_programado),\n  0\n);\n\nconst totalPagos = pagosInput.reduce(\n  (sum, pago) => sum + toNumber(pago.monto_programado),\n  0\n);\n\nif (Math.abs(totalPorcentaje - 100) > 0.01) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'La suma de porcentajes del plan de pagos debe ser 100%.',\n      },\n    },\n  ];\n}\n\nif (Math.abs(totalPagos - montoTotal) > 0.05) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'La suma de montos programados debe igualar el monto total comprometido.',\n      },\n    },\n  ];\n}\n\nconst operacionId = nextId(operacionesRows, 'operacion_id', 'OP');\n\nlet pagoMax = 0;\nfor (const row of pagosRows) {\n  const match = String(row.pago_id || '').match(/PAG-(\\d+)/);\n  if (match) {\n    const number = parseInt(match[1], 10);\n    if (number > pagoMax) pagoMax = number;\n  }\n}\n\nconst seguimientoId = nextId(seguimientoRows, 'seguimiento_id', 'SEG');\n\nconst preparedOperacion = {\n  operacion_id: operacionId,\n  cliente_id: operacion.cliente_id || '',\n  fecha_registro: operacion.fecha_registro || new Date().toISOString().slice(0, 10),\n  descripcion_operacion: String(operacion.descripcion_operacion || '').trim(),\n  cantidad: operacion.cantidad || '',\n  tipo_operacion: operacion.tipo_operacion || '',\n  tipo_empresa: operacion.tipo_empresa || '',\n  responsable: operacion.responsable || '',\n  estado_operacion: operacion.estado_operacion || '',\n  nivel_certeza: operacion.nivel_certeza || '',\n  probabilidad: operacion.probabilidad || '',\n  modalidad_pago: operacion.modalidad_pago || '',\n  monto_total_comprometido: operacion.monto_total_comprometido || '',\n  monto_total_ponderado: operacion.monto_total_ponderado || '',\n  vigencia_desde: operacion.vigencia_desde || '',\n  vigencia_hasta: operacion.vigencia_hasta || '',\n  proximo_hito: '',\n  fecha_proximo_hito: '',\n  observaciones: operacion.observaciones || '',\n  estado_general: operacion.estado_general || 'Activo',\n  created_by: operacion.created_by || '',\n  created_by_name: operacion.created_by_name || '',\n  created_at: operacion.created_at || new Date().toISOString(),\n  updated_by: '',\n  updated_by_name: '',\n  updated_at: '',\n};\n\nconst pagosProgramados = pagosInput.map((pago, index) => {\n  pagoMax += 1;\n\n  const montoProgramado = toNumber(pago.monto_programado);\n\n  return {\n    pago_id: `PAG-${String(pagoMax).padStart(4, '0')}`,\n    operacion_id: operacionId,\n    cliente_id: operacion.cliente_id || '',\n    numero_pago: pago.numero_pago || index + 1,\n    concepto_pago: pago.concepto_pago || `Pago ${index + 1}`,\n    porcentaje_programado: pago.porcentaje_programado || '',\n    monto_programado: montoProgramado,\n    fecha_programada: pago.fecha_programada || '',\n    estado_pago: pago.estado_pago || 'Pendiente',\n    monto_pagado_acumulado: 0,\n    saldo_pago: montoProgramado,\n    fecha_ultimo_pago: '',\n    modalidad_pago: operacion.modalidad_pago || '',\n    observaciones: '',\n    created_by: operacion.created_by || '',\n    created_by_name: operacion.created_by_name || '',\n    created_at: operacion.created_at || new Date().toISOString(),\n    updated_by: '',\n    updated_by_name: '',\n    updated_at: '',\n  };\n});\n\nconst preparedSeguimiento = {\n  seguimiento_id: seguimientoId,\n  operacion_id: operacionId,\n  cliente_id: operacion.cliente_id || '',\n  fecha_seguimiento: operacion.fecha_registro || new Date().toISOString().slice(0, 10),\n  tipo_evento: seguimientoInicial.tipo_evento || 'Registro',\n  comentario: seguimientoInicial.comentario || 'Registro inicial de operación comercial.',\n  proximo_hito: '',\n  fecha_proximo_hito: '',\n  estado_operacion_resultante:\n    seguimientoInicial.estado_operacion_resultante || operacion.estado_operacion || '',\n  created_by: seguimientoInicial.created_by || operacion.created_by || '',\n  created_by_name: seguimientoInicial.created_by_name || operacion.created_by_name || '',\n  created_at: seguimientoInicial.created_at || operacion.created_at || new Date().toISOString(),\n};\n\nreturn [\n  {\n    json: {\n      ok: true,\n      message: 'Operación preparada correctamente.',\n      operacion: preparedOperacion,\n      pagos_programados: pagosProgramados,\n      seguimiento: preparedSeguimiento,\n    },\n  },\n];"
