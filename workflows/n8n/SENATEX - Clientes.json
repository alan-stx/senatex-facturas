      "parameters": {
        "jsCode": "const rows = $input\n  .all()\n  .map(item => item.json)\n  .filter(row => row.cliente_id || row.razon_social || row.nit);\n\nconst webhookData = $('Webhook').first().json.body;\nconst cliente = webhookData.cliente || {};\n\nfunction normalize(value) {\n  return String(value || '')\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, ' ');\n}\n\nconst clienteId = String(cliente.cliente_id || '').trim();\nconst razonSocial = String(cliente.razon_social || '').trim();\nconst nit = String(cliente.nit || '').trim();\n\nif (!clienteId) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'El cliente_id es obligatorio para actualizar.',\n      },\n    },\n  ];\n}\n\nif (!razonSocial) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'La razón social es obligatoria.',\n      },\n    },\n  ];\n}\n\nconst existingCliente = rows.find(row => String(row.cliente_id || '').trim() === clienteId);\n\nif (!existingCliente) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'No se encontró el cliente que deseas actualizar.',\n      },\n    },\n  ];\n}\n\n// Validar duplicado por NIT, ignorando el mismo cliente\nif (nit) {\n  const duplicatedNit = rows.find(row => {\n    return (\n      String(row.nit || '').trim() === nit &&\n      String(row.cliente_id || '').trim() !== clienteId\n    );\n  });\n\n  if (duplicatedNit) {\n    return [\n      {\n        json: {\n          ok: false,\n          message: 'Ya existe otro cliente registrado con ese NIT.',\n        },\n      },\n    ];\n  }\n}\n\n// Validar duplicado por razón social, ignorando el mismo cliente\nconst duplicatedName = rows.find(row => {\n  return (\n    normalize(row.razon_social) === normalize(razonSocial) &&\n    String(row.cliente_id || '').trim() !== clienteId\n  );\n});\n\nif (duplicatedName) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'Ya existe otro cliente registrado con esa razón social.',\n      },\n    },\n  ];\n}\n\nconst updatedCliente = {\n  cliente_id: clienteId,\n  razon_social: razonSocial,\n  nombre_contacto: cliente.nombre_contacto || '',\n  nit,\n  tipo_cliente: cliente.tipo_cliente || '',\n  telefono: cliente.telefono || '',\n  correo: cliente.correo || '',\n  direccion: cliente.direccion || '',\n  estado_cliente: cliente.estado_cliente || 'Activo',\n  observaciones: cliente.observaciones || '',\n\n  // Mantener datos originales de creación\n  created_by: existingCliente.created_by || '',\n  created_by_name: existingCliente.created_by_name || '',\n  created_at: existingCliente.created_at || '',\n\n  // Datos de actualización\n  updated_by: cliente.updated_by || '',\n  updated_by_name: cliente.updated_by_name || '',\n  updated_at: cliente.updated_at || new Date().toISOString(),\n};\n\nreturn [\n  {\n    json: {\n      ok: true,\n      message: 'Cliente preparado para actualización.',\n      cliente: updatedCliente,\n    },\n  },\n];"
      },
