    {
      "parameters": {
        "jsCode": "const rows = $input\n  .all()\n  .map(item => item.json)\n  .filter(row => row.cliente_id || row.razon_social || row.nit);\n\n// El body original viene desde el Webhook\nconst webhookData = $('Webhook').first().json.body;\nconst cliente = webhookData.cliente || {};\n\nfunction normalize(value) {\n  return String(value || '')\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, ' ');\n}\n\nconst razonSocial = String(cliente.razon_social || '').trim();\nconst nit = String(cliente.nit || '').trim();\n\nif (!razonSocial) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'La razón social es obligatoria.',\n      },\n    },\n  ];\n}\n\n// Validar duplicado por NIT\nif (nit) {\n  const duplicatedNit = rows.find(row => String(row.nit || '').trim() === nit);\n\n  if (duplicatedNit) {\n    return [\n      {\n        json: {\n          ok: false,\n          message: 'Ya existe un cliente registrado con ese NIT.',\n        },\n      },\n    ];\n  }\n}\n\n// Validar duplicado por razón social\nconst duplicatedName = rows.find(row => normalize(row.razon_social) === normalize(razonSocial));\n\nif (duplicatedName) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: 'Ya existe un cliente registrado con esa razón social.',\n      },\n    },\n  ];\n}\n\n// Generar próximo cliente_id\nlet maxNumber = 0;\n\nfor (const row of rows) {\n  const id = String(row.cliente_id || '');\n  const match = id.match(/CLI-(\\d+)/);\n\n  if (match) {\n    const number = parseInt(match[1], 10);\n    if (number > maxNumber) maxNumber = number;\n  }\n}\n\nconst nextNumber = maxNumber + 1;\nconst clienteId = `CLI-${String(nextNumber).padStart(4, '0')}`;\n\nconst preparedCliente = {\n  cliente_id: clienteId,\n  razon_social: razonSocial,\n  nombre_contacto: cliente.nombre_contacto || '',\n  nit: nit,\n  tipo_cliente: cliente.tipo_cliente || '',\n  telefono: cliente.telefono || '',\n  correo: cliente.correo || '',\n  direccion: cliente.direccion || '',\n  estado_cliente: cliente.estado_cliente || 'Activo',\n  observaciones: cliente.observaciones || '',\n  created_by: cliente.created_by || '',\n  created_by_name: cliente.created_by_name || '',\n  created_at: cliente.created_at || new Date().toISOString(),\n  updated_by: '',\n  updated_by_name: '',\n  updated_at: '',\n};\n\nreturn [\n  {\n    json: {\n      ok: true,\n      message: 'Cliente preparado correctamente.',\n      cliente: preparedCliente,\n    },\n  },\n];"
      },
