      "parameters": {
        "jsCode": "const clientes = $input\n  .all()\n  .map(item => item.json)\n  .filter(row => row.cliente_id || row.razon_social || row.nit);\n\nreturn [\n  {\n    json: {\n      ok: true,\n      message: 'Clientes obtenidos correctamente.',\n      clientes,\n    },\n  },\n];"
      },
